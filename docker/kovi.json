{
  "name": "kovi",
  "repo": "ghcr.io/hsinghhira/kovi:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/hsinghhira/kovi/pkgs/container/kovi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=512m --cpus=1.00 --memory-reservation=48m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:3000/\" --health-interval=30s --health-timeout=5s --health-start-period=20s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/kovi/icon.png",
  "project": "https://git.sysmd.uk/mdaleo404/kovi",
  "support": "https://git.sysmd.uk/mdaleo404/kovi/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/kovi/",
  "description": "Reading dashboard for your KOReader statistics.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/kovi/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "The database, uploads and cached book covers."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6725",
      "container": "3000",
      "description": "kovi web app and KOReader plugin endpoints, published on host as 6725"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

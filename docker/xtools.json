{
  "name": "xtools",
  "repo": "ghcr.io/chenguangming/x-tools:1.0.0",
  "category": [
    "Utilities"
  ],
  "registry": "https://github.com/chenguangming/x-tools/pkgs/container/x-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=10 --memory=128m --cpus=0.50 --memory-reservation=16m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1/\" --health-interval=30s --health-timeout=5s --health-start-period=10s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/x-tools/icon.png",
  "project": "https://github.com/chenguangming/x-tools",
  "support": "https://github.com/chenguangming/x-tools/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/x-tools/",
  "description": "Toolbox of everyday and developer tools in your browser, from image cropping to ID photos.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6706",
      "container": "80",
      "description": "xtools web app, published on host as 6706"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

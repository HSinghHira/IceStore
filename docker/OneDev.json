{
  "name": "OneDev",
  "repo": "1dev/server:17.2.4",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/1dev/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2g --memory-reservation=256m --health-cmd=\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/6610'\" --health-interval=30s --health-timeout=10s --health-start-period=2m --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6610]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/onedev/icon.png",
  "project": "https://onedev.io",
  "support": "https://github.com/theonedev/onedev/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/onedev/",
  "description": "Git server with CI/CD, kanban boards and code search, in one app",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Onedev",
      "host": "/mnt/cache/appdata/onedev/data",
      "container": "/opt/onedev",
      "mode": "rw",
      "description": "Your repositories, the built-in database, builds, settings and logs. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6842",
      "container": "6610",
      "description": "OneDev web app and Git over http, published on host as 6842"
    },
    {
      "name": "Port 6611",
      "protocol": "tcp",
      "host": "6843",
      "container": "6611",
      "description": "Git over SSH, published on host as 6843"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

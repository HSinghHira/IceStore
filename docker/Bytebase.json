{
  "name": "Bytebase",
  "repo": "bytebase/bytebase:3.25.0",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/bytebase/bytebase",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2g --memory-reservation=128m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8080/healthz\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/bytebase/icon.png",
  "project": "https://www.bytebase.com",
  "support": "https://github.com/bytebase/bytebase/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/bytebase/",
  "description": "Database change management, SQL editor and access control in one web app",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Bytebase",
      "host": "/mnt/cache/appdata/bytebase/data",
      "container": "/var/opt/bytebase",
      "mode": "rw",
      "description": "Bytebase's own built-in PostgreSQL database with your projects, users, connections and change history. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6823",
      "container": "8080",
      "description": "Bytebase web app and API, published on host as 6823"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

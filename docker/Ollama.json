{
  "name": "Ollama",
  "repo": "ollama/ollama:0.40.18",
  "category": [
    "AI"
  ],
  "registry": "https://hub.docker.com/r/ollama/ollama",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=16g --memory-reservation=256m --health-cmd=\"ollama list\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:11434]/api/version",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/ollama/icon.png",
  "project": "https://ollama.com",
  "support": "https://github.com/ollama/ollama/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/ollama/",
  "description": "Runs open large language models on your own hardware behind a simple API",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": ".Ollama",
      "host": "/mnt/cache/appdata/ollama/models",
      "container": "/root/.ollama",
      "mode": "rw",
      "description": "Downloaded models (often several GB each) and Ollama's keys."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6844",
      "container": "11434",
      "description": "Ollama API, published on host as 6844"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "OLLAMA_KEEP_ALIVE",
      "key": "OLLAMA_KEEP_ALIVE",
      "value": "5m",
      "mask": false,
      "description": "How long a model stays in memory after its last use, like 5m or 1h."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

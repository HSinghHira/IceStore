{
  "name": "LanguageTool",
  "repo": "erikvl87/languagetool:6.8",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/erikvl87/languagetool",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=2g --memory-reservation=256m --user=0:0 --health-cmd=\"curl -fsS -o /dev/null --data 'language=en-US&text=a simple test' http://127.0.0.1:8010/v2/check\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8010]/v2/languages",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/languagetool/icon.png",
  "project": "https://languagetool.org",
  "support": "https://github.com/Erikvl87/docker-languagetool/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/languagetool/",
  "description": "Grammar, style and spell checker server for over 30 languages",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Ngrams",
      "host": "/mnt/cache/appdata/languagetool/ngrams",
      "container": "/ngrams",
      "mode": "rw",
      "description": "Optional n-gram data for better checks (download from languagetool.org, several GB per language)."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6839",
      "container": "8010",
      "description": "LanguageTool API, published on host as 6839"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "Java_Xmx",
      "key": "Java_Xmx",
      "value": "1g",
      "mask": false,
      "description": "The most memory LanguageTool may use, like 1g or 2g (keep it below the app's limit)."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Channel-Club",
  "repo": "jonnike/channel-club:1.3.2",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jonnike/channel-club",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --init --stop-timeout=20 --memory=1024m --cpus=2.00 --memory-reservation=128m --user=0:0 --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8334/api/health\" --health-interval=30s --health-timeout=10s --health-start-period=40s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8334]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/channel-club/icon.png",
  "project": "https://github.com/jo-nike/channel_club#readme",
  "support": "https://github.com/jo-nike/channel_club/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/channel-club/",
  "description": "Watch live TV together, from Dispatcharr or ErsatzTV.",
  "architecture": [
    "amd64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/channel-club/data",
      "container": "/data",
      "mode": "rw",
      "description": "Your settings from the setup wizard and admin panel (settings.json, with your Plex token and API keys), the sign-in key and the shared Live state (state.json). Keep this folder private and back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6174",
      "container": "8334",
      "description": "Channel Club player, setup wizard and admin panel, published on host as 6174"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

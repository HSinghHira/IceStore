{
  "name": "big-AGI",
  "repo": "ghcr.io/enricoros/big-agi:v2.1.3",
  "category": [
    "AI"
  ],
  "registry": "https://github.com/enricoros/big-agi/pkgs/container/big-agi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=512m --memory-reservation=64m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:3000/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/big-agi/icon.png",
  "project": "https://big-agi.com",
  "support": "https://github.com/enricoros/big-AGI/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/big-agi/",
  "description": "AI chat workspace for many models side by side, with personas and voice",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6845",
      "container": "3000",
      "description": "big-AGI web app, published on host as 6845"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Komga",
  "repo": "gotson/komga:1.30.2",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/gotson/komga",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2g --memory-reservation=128m --health-cmd=\"curl -s -o /dev/null http://127.0.0.1:25600/\" --health-interval=30s --health-timeout=10s --health-start-period=90s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:25600]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/komga/icon.png",
  "project": "https://komga.org",
  "support": "https://github.com/gotson/komga/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/komga/",
  "description": "Media server for comics, manga, magazines and ebooks",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/komga/config",
      "container": "/config",
      "mode": "rw",
      "description": "Komga's database, thumbnails, Lucene search index, logs and settings (application.yml). Back it up."
    },
    {
      "name": "Data",
      "host": "/DATA",
      "container": "/DATA",
      "mode": "rw",
      "description": "Your MOS storage at the same path. Add a folder like /mnt/cache/media/Comics as a library."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6819",
      "container": "25600",
      "description": "Komga web reader, published on host as 6819"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

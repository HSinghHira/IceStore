{
  "name": "Apache-Answer",
  "repo": "apache/answer:2.0.3",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/apache/answer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=512m --memory-reservation=32m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:80/healthz\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/answer/icon.png",
  "project": "https://answer.apache.org",
  "support": "https://github.com/apache/answer/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/answer/",
  "description": "Q&A platform for teams and communities, like your own Stack Overflow",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/answer/data",
      "container": "/data",
      "mode": "rw",
      "description": "The SQLite database, uploads, config (conf/config.yaml) and plugins. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6835",
      "container": "80",
      "description": "Apache Answer web app, published on host as 6835"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

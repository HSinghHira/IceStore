{
  "name": "CartVibe",
  "repo": "ghcr.io/hsinghhira/cartvibe:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/hsinghhira/cartvibe/pkgs/container/cartvibe",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=1536m --cpus=2.00 --memory-reservation=128m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:80/\" --health-interval=30s --health-timeout=5s --health-start-period=40s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/cartvibe/icon.png",
  "project": "https://github.com/wouekk/cartvibe#readme",
  "support": "https://github.com/wouekk/cartvibe/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/cartvibe/",
  "description": "Household receipts, shared shopping lists and spending insights.",
  "architecture": [
    "amd64"
  ],
  "paths": [
    {
      "name": "Sqlite",
      "host": "/mnt/cache/appdata/cartvibe/sqlite",
      "container": "/app/cartvibe-api/sqlite",
      "mode": "rw",
      "description": "The database, Valkey's queue and this install's SECRET_KEY and ENCRYPTION_KEY (.icestore/). Back it up: without ENCRYPTION_KEY, saved AI and sign-in keys can't be read."
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/cartvibe/data",
      "container": "/app/cartvibe-api/data",
      "mode": "rw",
      "description": "Receipt photos."
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/cartvibe/logs",
      "container": "/app/cartvibe-api/logs",
      "mode": "rw",
      "description": "CartVibe's logs."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6717",
      "container": "80",
      "description": "CartVibe web app and API, published on host as 6717"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "drawDB",
  "repo": "ghcr.io/drawdb-io/drawdb:v1.9.0",
  "category": [
    "Utilities"
  ],
  "registry": "https://github.com/drawdb-io/drawdb/pkgs/container/drawdb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=10 --memory=128m --cpus=0.50 --memory-reservation=16m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:80/ || wget -q -O /dev/null http://127.0.0.1:80/\" --health-interval=30s --health-timeout=10s --health-start-period=15s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/drawdb/icon.png",
  "project": "https://drawdb.app/",
  "support": "https://github.com/drawdb-io/drawdb/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/drawdb/",
  "description": "Draw database diagrams in your browser and turn them into SQL",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6794",
      "container": "80",
      "description": "drawDB editor, published on host as 6794"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

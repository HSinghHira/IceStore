{
  "name": "Jellyfin",
  "repo": "jellyfin/jellyfin:10.11.11",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jellyfin/jellyfin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=4g --cpus=4.00 --memory-reservation=256m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8096/health\" --health-interval=30s --health-timeout=30s --health-start-period=90s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8096]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/jellyfin/icon.png",
  "project": "https://jellyfin.org/",
  "support": "https://github.com/jellyfin/jellyfin/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/jellyfin/",
  "description": "Stream your own movies, shows and music to every screen",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/jellyfin/config",
      "container": "/config",
      "mode": "rw",
      "description": "Jellyfin's settings, users, watch history and library database. Back it up."
    },
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/jellyfin/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Images and transcoding scratch files. Safe to delete."
    },
    {
      "name": "Data",
      "host": "/DATA",
      "container": "/DATA",
      "mode": "rw",
      "description": "Your MOS storage, at the same path inside, so libraries can point at folders like /mnt/cache/media/Movies."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6798",
      "container": "8096",
      "description": "Jellyfin web app and the address for Jellyfin apps, published on host as 6798"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

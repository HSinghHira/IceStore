{
  "name": "Wallos",
  "repo": "bellamy/wallos:5.11.1",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bellamy/wallos",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=256m --cpus=0.50 --memory-reservation=32m --health-cmd=\"curl -fsS http://127.0.0.1/health.php\" --health-interval=60s --health-timeout=5s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/wallos/icon.png",
  "project": "https://wallosapp.com",
  "support": "https://github.com/ellite/Wallos/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/wallos/",
  "description": "Track your subscriptions and what they cost each month.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Db",
      "host": "/mnt/cache/appdata/wallos/db",
      "container": "/var/www/html/db",
      "mode": "rw",
      "description": "The Wallos database: your users, subscriptions and settings. Back this folder up."
    },
    {
      "name": "Logos",
      "host": "/mnt/cache/appdata/wallos/logos",
      "container": "/var/www/html/images/uploads/logos",
      "mode": "rw",
      "description": "The logos you add to subscriptions."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6735",
      "container": "80",
      "description": "Wallos web page, published on host as 6735"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

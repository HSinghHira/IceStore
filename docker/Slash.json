{
  "name": "Slash",
  "repo": "yourselfhosted/slash:0.5.3",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/yourselfhosted/slash",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=10 --memory=256m --memory-reservation=16m --health-cmd=\"nc -z 127.0.0.1 5231\" --health-interval=30s --health-timeout=5s --health-start-period=20s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5231]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/slash/icon.png",
  "project": "https://github.com/yourselfhosted/slash",
  "support": "https://github.com/yourselfhosted/slash/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/slash/",
  "description": "Short links and shared bookmarks, like s/meeting for your team",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Slash",
      "host": "/mnt/cache/appdata/slash/data",
      "container": "/var/opt/slash",
      "mode": "rw",
      "description": "Slash's SQLite database with your users, links and collections. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6892",
      "container": "5231",
      "description": "Slash web app and short links, published on host as 6892"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "SLASH_METRIC",
      "key": "SLASH_METRIC",
      "value": "false",
      "mask": false,
      "description": "false stops Slash from sending usage numbers to its makers. true turns that back on."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

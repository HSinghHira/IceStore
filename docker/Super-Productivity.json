{
  "name": "Super-Productivity",
  "repo": "johannesjo/super-productivity:v20.1.0",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/johannesjo/super-productivity",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=128m --memory-reservation=16m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:80/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/super-productivity/icon.png",
  "project": "https://super-productivity.com",
  "support": "https://github.com/super-productivity/super-productivity/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/super-productivity/",
  "description": "To-do list with time tracking, timeboxing and integrations",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6841",
      "container": "80",
      "description": "Super Productivity web app, published on host as 6841"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

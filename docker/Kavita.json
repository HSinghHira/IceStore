{
  "name": "Kavita",
  "repo": "jvmilazz0/kavita:0.9.1",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/jvmilazz0/kavita",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2g --memory-reservation=128m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:5000/api/health\" --health-interval=30s --health-timeout=15s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/kavita/icon.png",
  "project": "https://www.kavitareader.com",
  "support": "https://github.com/Kareadita/Kavita/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/kavita/",
  "description": "Reading server for manga, comics and ebooks",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/kavita/config",
      "container": "/kavita/config",
      "mode": "rw",
      "description": "Kavita's settings (appsettings.json), database, covers, logs and backups. Back it up."
    },
    {
      "name": "Cache",
      "host": "/mnt/cache",
      "container": "/mnt/cache",
      "mode": "rw",
      "description": "Your MOS storage at the same path. Add a folder like /mnt/cache/media/Comics as a library."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6812",
      "container": "5000",
      "description": "Kavita web reader and OPDS, published on host as 6812"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Seerr",
  "repo": "ghcr.io/seerr-team/seerr:v3.5.2",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/seerr-team/seerr/pkgs/container/seerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=1g --memory-reservation=64m --user=0:0 --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:5055/api/v1/status\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5055]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/seerr/icon.png",
  "project": "https://docs.seerr.dev",
  "support": "https://github.com/seerr-team/seerr/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/seerr/",
  "description": "Request movies and shows for Jellyfin, Plex and Emby, with Sonarr and Radarr",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/seerr/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Seerr's database, settings and logs. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6830",
      "container": "5055",
      "description": "Seerr web app and API, published on host as 6830"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "LOG_LEVEL",
      "key": "LOG_LEVEL",
      "value": "info",
      "mask": false,
      "description": "How much is logged: debug, info, warn or error."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

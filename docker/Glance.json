{
  "name": "Glance",
  "repo": "ghcr.io/hsinghhira/glance:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/hsinghhira/glance/pkgs/container/glance",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=16m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:8080/api/healthz\" --health-interval=30s --health-timeout=5s --health-start-period=10s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/glance/icon.png",
  "project": "https://github.com/glanceapp/glance/blob/main/docs/configuration.md",
  "support": "https://github.com/glanceapp/glance/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/glance/",
  "description": "Dashboard that puts your feeds, widgets and server stats on one page",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/glance/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Your dashboard (glance.yml) and your own icons and styles (assets). Edit glance.yml with the MOS Files app; Glance reloads it when you save."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6808",
      "container": "8080",
      "description": "Glance dashboard, published on host as 6808"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

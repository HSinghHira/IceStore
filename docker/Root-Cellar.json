{
  "name": "Root-Cellar",
  "repo": "ghcr.io/hsinghhira/root-cellar:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/hsinghhira/root-cellar/pkgs/container/root-cellar",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=768m --cpus=1.00 --memory-reservation=96m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8080/\" --health-interval=30s --health-timeout=5s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/root-cellar/icon.png",
  "project": "https://github.com/Noobie3DPrinting/root-cellar/blob/main/GUIDE.md",
  "support": "https://github.com/Noobie3DPrinting/root-cellar/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/root-cellar/",
  "description": "Household apps in one place: a shared checkbook, notes, a movie collection and labels.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/root-cellar/data",
      "container": "/data",
      "mode": "rw",
      "description": "Each app's data in its own folder (checkbook/, notes/, movies/, labels/), including Notes' backups and the Labels printer setup. Back up the whole folder."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6711",
      "container": "8080",
      "description": "Checkbook, published on host as 6711"
    },
    {
      "name": "Port 8085",
      "protocol": "tcp",
      "host": "6712",
      "container": "8085",
      "description": "Notes, published on host as 6712"
    },
    {
      "name": "Port 8093",
      "protocol": "tcp",
      "host": "6713",
      "container": "8093",
      "description": "Movies, published on host as 6713"
    },
    {
      "name": "Port 8095",
      "protocol": "tcp",
      "host": "6714",
      "container": "8095",
      "description": "Labels, published on host as 6714"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

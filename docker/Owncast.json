{
  "name": "Owncast",
  "repo": "ghcr.io/hsinghhira/owncast:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/hsinghhira/owncast/pkgs/container/owncast",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2g --memory-reservation=64m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:8080/api/status\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/owncast/icon.png",
  "project": "https://owncast.online",
  "support": "https://github.com/owncast/owncast/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/owncast/",
  "description": "Your own live streaming server with chat, like Twitch at home",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/owncast/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Owncast's database with settings, chat and followers, its logs, backups and this install's admin password and stream key. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6860",
      "container": "8080",
      "description": "Owncast stream page, chat and admin (/admin), published on host as 6860"
    },
    {
      "name": "Port 1935",
      "protocol": "tcp",
      "host": "6861",
      "container": "1935",
      "description": "RTMP input for OBS and other streaming apps, published on host as 6861"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

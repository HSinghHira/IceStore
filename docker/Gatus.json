{
  "name": "Gatus",
  "repo": "ghcr.io/hsinghhira/gatus:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/hsinghhira/gatus/pkgs/container/gatus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=16m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:8080/health\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/gatus/icon.png",
  "project": "https://gatus.io",
  "support": "https://github.com/TwiN/gatus/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/gatus/",
  "description": "Status page and uptime monitor configured in one YAML file",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/gatus/config",
      "container": "/config",
      "mode": "rw",
      "description": "Your checks in config.yaml (a starter one is written on first start). Edit it with the Files app; Gatus reloads it by itself."
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/gatus/data",
      "container": "/data",
      "mode": "rw",
      "description": "The SQLite database with check history."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6857",
      "container": "8080",
      "description": "Gatus status page and API, published on host as 6857"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

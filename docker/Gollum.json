{
  "name": "Gollum",
  "repo": "gollumwiki/gollum:v5.3.2",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/gollumwiki/gollum",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=512m --memory-reservation=32m --health-cmd=\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/4567'\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4567]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/gollum/icon.png",
  "project": "https://github.com/gollum/gollum/wiki",
  "support": "https://github.com/gollum/gollum/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/gollum/",
  "description": "Simple wiki that keeps every page in a Git repository",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Wiki",
      "host": "/mnt/cache/appdata/gollum/wiki",
      "container": "/wiki",
      "mode": "rw",
      "description": "Your wiki: a Git repository with one file per page. Back it up, or push it to another Git server."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6852",
      "container": "4567",
      "description": "Gollum wiki, published on host as 6852"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "GOLLUM_AUTHOR_USERNAME",
      "key": "GOLLUM_AUTHOR_USERNAME",
      "value": "Gollum",
      "mask": false,
      "description": "The name saved with each change in Git."
    },
    {
      "name": "GOLLUM_AUTHOR_EMAIL",
      "key": "GOLLUM_AUTHOR_EMAIL",
      "value": "gollum@localhost",
      "mask": false,
      "description": "The email saved with each change in Git."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

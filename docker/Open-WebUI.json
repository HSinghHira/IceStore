{
  "name": "Open-WebUI",
  "repo": "ghcr.io/hsinghhira/open-webui:latest",
  "category": [
    "AI"
  ],
  "registry": "https://github.com/hsinghhira/open-webui/pkgs/container/open-webui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=4g --memory-reservation=256m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8080/health\" --health-interval=30s --health-timeout=10s --health-start-period=3m --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/open-webui/icon.png",
  "project": "https://openwebui.com",
  "support": "https://github.com/open-webui/open-webui/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/open-webui/",
  "description": "Chat interface for Ollama and OpenAI-compatible models, with RAG and tools",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/open-webui/data",
      "container": "/app/backend/data",
      "mode": "rw",
      "description": "The database with users and chats, uploaded documents, the vector store, cached models and this install's secret key. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6863",
      "container": "8080",
      "description": "Open WebUI web app and API, published on host as 6863"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

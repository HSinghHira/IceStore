{
  "name": "Pinchflat",
  "repo": "ghcr.io/kieraneglin/pinchflat:v2025.6.6",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/kieraneglin/pinchflat/pkgs/container/pinchflat",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=1g --memory-reservation=64m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8945/healthcheck\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8945]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/pinchflat/icon.png",
  "project": "https://github.com/kieraneglin/pinchflat/wiki",
  "support": "https://github.com/kieraneglin/pinchflat/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/pinchflat/",
  "description": "Downloads YouTube channels and playlists on a schedule with yt-dlp",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/pinchflat/config",
      "container": "/config",
      "mode": "rw",
      "description": "Pinchflat's database, settings, cookies file and logs."
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/media/YouTube",
      "container": "/downloads",
      "mode": "rw",
      "description": "Where videos are saved: /mnt/cache/media/YouTube on your MOS. Add it to Jellyfin or Plex."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6824",
      "container": "8945",
      "description": "Pinchflat web app, published on host as 6824"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

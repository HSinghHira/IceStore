{
  "name": "FluxDown",
  "repo": "ghcr.io/zerx-lab/fluxdown-server:0.6.3",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/zerx-lab/fluxdown-server/pkgs/container/fluxdown-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=40 --memory=1024m --cpus=2.00 --memory-reservation=128m",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:17800]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/fluxdown/icon.png",
  "project": "https://github.com/zerx-lab/FluxDown",
  "support": "https://github.com/zerx-lab/FluxDown/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/fluxdown/",
  "description": "Fast multi-protocol download manager with a web UI.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/fluxdown/data",
      "container": "/data",
      "mode": "rw",
      "description": "Database, logs and your access key."
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads",
      "container": "/root/Downloads",
      "mode": "rw",
      "description": "Default folder for finished downloads. Stored in the Downloads folder on MOS."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6107",
      "container": "17800",
      "description": "Web UI, API and MCP endpoint, published on host as 6107."
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

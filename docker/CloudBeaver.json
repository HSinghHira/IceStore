{
  "name": "CloudBeaver",
  "repo": "dbeaver/cloudbeaver:26.2.5",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/dbeaver/cloudbeaver",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2g --memory-reservation=128m --health-cmd=\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/8978'\" --health-interval=30s --health-timeout=10s --health-start-period=90s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8978]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/cloudbeaver/icon.png",
  "project": "https://dbeaver.com/cloudbeaver",
  "support": "https://github.com/dbeaver/cloudbeaver/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/cloudbeaver/",
  "description": "Database manager in the browser, from the makers of DBeaver",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Workspace",
      "host": "/mnt/cache/appdata/cloudbeaver/workspace",
      "container": "/opt/cloudbeaver/workspace",
      "mode": "rw",
      "description": "CloudBeaver's settings, users, saved connections and scripts. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6856",
      "container": "8978",
      "description": "CloudBeaver web app, published on host as 6856"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

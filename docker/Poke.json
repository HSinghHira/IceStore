{
  "name": "Poke",
  "repo": "ghcr.io/hsinghhira/poke:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/hsinghhira/poke/pkgs/container/poke",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=90 --memory=3072m --cpus=2.00 --memory-reservation=512m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8080/api/version.json\" --health-interval=30s --health-timeout=10s --health-start-period=240s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/poke/icon.png",
  "project": "https://poketube.fun",
  "support": "https://codeberg.org/ashleyirispuppy/poke/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/poke/",
  "description": "A privacy-friendly YouTube front-end, with its own Invidious inside.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/poke/data",
      "container": "/data",
      "mode": "rw",
      "description": "Poke accounts and subscriptions (poke/json.sqlite), the Invidious database and the secret keys (state/secrets.env)."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6133",
      "container": "8080",
      "description": "Poke web app and video streams, published on host as 6133"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

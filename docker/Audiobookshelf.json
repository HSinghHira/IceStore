{
  "name": "Audiobookshelf",
  "repo": "ghcr.io/advplyr/audiobookshelf:2.38.0",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/advplyr/audiobookshelf/pkgs/container/audiobookshelf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=1g --memory-reservation=64m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:80/healthcheck\" --health-interval=30s --health-timeout=5s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/audiobookshelf/icon.png",
  "project": "https://www.audiobookshelf.org",
  "support": "https://github.com/advplyr/audiobookshelf/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/audiobookshelf/",
  "description": "Audiobook and podcast server with apps for your phone",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/audiobookshelf/config",
      "container": "/config",
      "mode": "rw",
      "description": "The database with your users, libraries and listening progress. Back it up."
    },
    {
      "name": "Metadata",
      "host": "/mnt/cache/appdata/audiobookshelf/metadata",
      "container": "/metadata",
      "mode": "rw",
      "description": "Covers, author photos, cache, logs and backups."
    },
    {
      "name": "Data",
      "host": "/DATA",
      "container": "/DATA",
      "mode": "rw",
      "description": "Your MOS storage at the same path. Add a folder like /mnt/cache/media/Audiobooks as a library. Podcasts are downloaded into their library folder."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6811",
      "container": "80",
      "description": "Audiobookshelf web app and API, published on host as 6811"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

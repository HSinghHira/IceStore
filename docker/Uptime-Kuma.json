{
  "name": "Uptime-Kuma",
  "repo": "louislam/uptime-kuma:2.5.12",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/louislam/uptime-kuma",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=1g --cpus=1.00 --memory-reservation=128m --health-cmd=\"/app/extra/healthcheck\" --health-interval=60s --health-timeout=30s --health-start-period=180s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3001]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/uptime-kuma/icon.png",
  "project": "https://uptime.kuma.pet/",
  "support": "https://github.com/louislam/uptime-kuma/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/uptime-kuma/",
  "description": "Watches your websites and services and tells you when one goes down",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/uptime-kuma/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Uptime Kuma's database (SQLite or the built-in MariaDB) with your monitors, history, alerts and status pages. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6792",
      "container": "3001",
      "description": "Uptime Kuma dashboard and status pages, published on host as 6792"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Nginx",
  "repo": "nginx:1.31.10-alpine",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/_/nginx",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=128m --memory-reservation=8m --health-cmd=\"wget -q --spider http://127.0.0.1:80/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/nginx/icon.png",
  "project": "https://nginx.org",
  "support": "https://github.com/nginx/nginx/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/nginx/",
  "description": "Web server for hosting your static websites",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Html",
      "host": "/mnt/cache/appdata/nginx/html",
      "container": "/usr/share/nginx/html",
      "mode": "rw",
      "description": "Your website files. Put index.html here with the Files app."
    },
    {
      "name": "Conf.D",
      "host": "/mnt/cache/appdata/nginx/conf.d",
      "container": "/etc/nginx/conf.d",
      "mode": "rw",
      "description": "Nginx site settings (*.conf). Leave it empty for the default site; IceStore writes nothing here."
    },
    {
      "name": "Templates",
      "host": "/mnt/cache/appdata/nginx/templates",
      "container": "/etc/nginx/templates",
      "mode": "rw",
      "description": "Optional *.conf.template files, filled in with your environment variables on start."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6849",
      "container": "80",
      "description": "Your website, published on host as 6849"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Fluidd",
  "repo": "ghcr.io/fluidd-core/fluidd:v1.38.1",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/fluidd-core/fluidd/pkgs/container/fluidd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=10 --memory=64m --memory-reservation=8m --health-cmd=\"wget -q -O /dev/null -T 2 http://127.0.0.1:80/healthz\" --health-interval=30s --health-timeout=5s --health-start-period=10s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/fluidd/icon.png",
  "project": "https://docs.fluidd.xyz",
  "support": "https://github.com/fluidd-core/fluidd/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/fluidd/",
  "description": "A clean web interface for Klipper 3D printers",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "7006",
      "container": "80",
      "description": "Fluidd web page, published on host as 7006"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

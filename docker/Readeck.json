{
  "name": "Readeck",
  "repo": "codeberg.org/readeck/readeck:0.23.5",
  "category": [
    "Productivity"
  ],
  "registry": "https://codeberg.org/readeck/readeck",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=512m --cpus=1.00 --memory-reservation=32m --health-cmd=\"wget -q --spider http://127.0.0.1:8000/\" --health-interval=30s --health-timeout=5s --health-start-period=20s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/readeck/icon.png",
  "project": "https://readeck.org",
  "support": "https://codeberg.org/readeck/readeck/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/readeck/",
  "description": "Save web pages, articles and videos to read later, with highlights.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Readeck",
      "host": "/mnt/cache/appdata/readeck/data",
      "container": "/readeck",
      "mode": "rw",
      "description": "Readeck's settings (config.toml, with its secret key), database and saved pages. Back this folder up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6741",
      "container": "8000",
      "description": "Readeck web page and API, published on host as 6741"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "READECK_SERVER_PORT",
      "key": "READECK_SERVER_PORT",
      "value": "8000",
      "mask": false,
      "description": "The port Readeck listens on inside the container. Leave it as 8000."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

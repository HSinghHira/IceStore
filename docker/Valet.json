{
  "name": "Valet",
  "repo": "ghcr.io/askvalet/valet:0.3.0",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/askvalet/valet/pkgs/container/valet",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=512m --cpus=1.00 --memory-reservation=48m --user=0:0 --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:7575/healthz\" --health-interval=30s --health-timeout=5s --health-start-period=20s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7575]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/valet/icon.png",
  "project": "https://askvalet.dev",
  "support": "https://github.com/askvalet/valet/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/valet/",
  "description": "An AI homepage for your homelab that you can talk to.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/valet/config",
      "container": "/config",
      "mode": "rw",
      "description": "config.yaml, the one file that sets up the page: your services, cards, sign-in and the assistant. Valet writes a starter on first start; edits show up live."
    },
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/valet/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Wallpaper, icon cache, uploads, history, accounts (users.json) and plugins."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6701",
      "container": "7575",
      "description": "Valet homepage, published on host as 6701"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Domoticz",
  "repo": "domoticz/domoticz:2026.4",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/domoticz/domoticz",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=512m --memory-reservation=32m --health-cmd=\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080'\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/domoticz/icon.png",
  "project": "https://www.domoticz.com",
  "support": "https://github.com/domoticz/domoticz/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/domoticz/",
  "description": "Home automation system for lights, sensors, switches and energy meters",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Userdata",
      "host": "/mnt/cache/appdata/domoticz/userdata",
      "container": "/opt/domoticz/userdata",
      "mode": "rw",
      "description": "Domoticz's database, scripts, plugins and logs. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6847",
      "container": "8080",
      "description": "Domoticz web app and API, published on host as 6847"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Prowlarr",
  "repo": "lscr.io/linuxserver/prowlarr:3.1.0.5799-ls170",
  "category": [
    "Media"
  ],
  "registry": "https://lscr.io/linuxserver/prowlarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=512m --memory-reservation=64m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:9696/ping\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9696]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/prowlarr/icon.png",
  "project": "https://prowlarr.com",
  "support": "https://github.com/Prowlarr/Prowlarr/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/prowlarr/",
  "description": "One place to manage indexers for Sonarr, Radarr and Lidarr",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/prowlarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Prowlarr's database, indexers, settings, API key and logs. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6880",
      "container": "9696",
      "description": "Prowlarr web app and API, published on host as 6880"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "mask": false,
      "description": "The user id that owns the app's files. 500 is the MOS default."
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "mask": false,
      "description": "The group id that owns the app's files. 500 is the MOS default."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

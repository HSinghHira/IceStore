{
  "name": "Ombi",
  "repo": "lscr.io/linuxserver/ombi:v4.53.10-ls278",
  "category": [
    "Media"
  ],
  "registry": "https://lscr.io/linuxserver/ombi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=1g --memory-reservation=64m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:3579/\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3579]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/ombi/icon.png",
  "project": "https://ombi.io",
  "support": "https://github.com/Ombi-app/Ombi/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/ombi/",
  "description": "Lets your users request movies, shows and music for Plex, Emby and Jellyfin",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/ombi/config",
      "container": "/config",
      "mode": "rw",
      "description": "Ombi's databases, settings and logs. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6833",
      "container": "3579",
      "description": "Ombi web app and API, published on host as 6833"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "mask": false,
      "description": "The user id that owns the app's files. 500 is the MOS default."
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "mask": false,
      "description": "The group id that owns the app's files. 500 is the MOS default."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Natel",
  "repo": "ghcr.io/kewindousse/natel:0.5.0",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/kewindousse/natel/pkgs/container/natel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=128m --cpus=0.50 --memory-reservation=16m",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/natel/icon.png",
  "project": "https://natel.app",
  "support": "https://github.com/KewinDousse/natel/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/natel/",
  "description": "Lightweight web app to browse and edit the contacts on your CardDAV server",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6196",
      "container": "8080",
      "description": "Natel web app, published on host as 6196"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "CARDDAV_URL",
      "key": "CARDDAV_URL",
      "value": "https://dav.example.com",
      "mask": false,
      "description": "Required. The address of your CardDAV server, without a path, like http://192.168.1.20:5232 for Radicale or https://dav.example.com for Baikal."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

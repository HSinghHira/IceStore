{
  "name": "RSS-Bridge",
  "repo": "rssbridge/rss-bridge:2026-09-30",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/rssbridge/rss-bridge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=32m --health-cmd=\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/80'\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/rss-bridge/icon.png",
  "project": "https://rss-bridge.github.io/rss-bridge/",
  "support": "https://github.com/RSS-Bridge/rss-bridge/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/rss-bridge/",
  "description": "Makes RSS and Atom feeds for websites that do not have one",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/rss-bridge/config",
      "container": "/config",
      "mode": "rw",
      "description": "Your own config.ini.php and whitelist.txt (which bridges are on), and your own bridges. Leave it empty for the defaults."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6834",
      "container": "80",
      "description": "RSS-Bridge web page and feeds, published on host as 6834"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

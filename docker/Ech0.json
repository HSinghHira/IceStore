{
  "name": "Ech0",
  "repo": "ghcr.io/hsinghhira/ech0:latest",
  "category": [
    "Network"
  ],
  "registry": "https://github.com/hsinghhira/ech0/pkgs/container/ech0",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=512m --cpus=1.00 --memory-reservation=64m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:6277/\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6277]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/ech0/icon.png",
  "project": "https://www.ech0.app/",
  "support": "https://github.com/lin-snow/Ech0/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/ech0/",
  "description": "Your own microblog timeline for short posts, links and media",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/ech0/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Everything Ech0 keeps: the SQLite database, your uploaded images, audio and video (files), backups, logs and this install's own key (secrets.env). Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6782",
      "container": "6277",
      "description": "Ech0 timeline, admin panel and API, published on host as 6782"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "NextChat",
  "repo": "yidadaa/chatgpt-next-web:v2.16.1",
  "category": [
    "AI"
  ],
  "registry": "https://hub.docker.com/r/yidadaa/chatgpt-next-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=512m --memory-reservation=64m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:3000/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/nextchat/icon.png",
  "project": "https://github.com/ChatGPTNextWeb/NextChat#readme",
  "support": "https://github.com/ChatGPTNextWeb/NextChat/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/nextchat/",
  "description": "Light, fast AI chat app for GPT, Claude, Gemini and local models",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6846",
      "container": "3000",
      "description": "NextChat web app, published on host as 6846"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

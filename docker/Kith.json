{
  "name": "Kith",
  "repo": "ghcr.io/hsinghhira/kith:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/hsinghhira/kith/pkgs/container/kith",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=60 --memory=1024m --cpus=2.00 --memory-reservation=192m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8000/\" --health-interval=30s --health-timeout=10s --health-start-period=90s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/kith/icon.png",
  "project": "https://github.com/dreed47/kith#readme",
  "support": "https://github.com/dreed47/kith/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/kith/",
  "description": "Private family history website for your family tree.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/kith/data",
      "container": "/data",
      "mode": "rw",
      "description": "The database (mysql/), photos and documents (media/), the site's own files and secret key (instance/) and the passwords made on first start (state/). Back up the whole folder."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6707",
      "container": "8000",
      "description": "Kith family history site, published on host as 6707"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

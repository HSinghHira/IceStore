{
  "name": "BentoPDF",
  "repo": "ghcr.io/alam00000/bentopdf:2.8.12",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/alam00000/bentopdf/pkgs/container/bentopdf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=128m --memory-reservation=16m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:8080/\" --health-interval=30s --health-timeout=5s --health-start-period=10s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/bentopdf/icon.png",
  "project": "https://www.bentopdf.com",
  "support": "https://github.com/alam00000/bentopdf/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/bentopdf/",
  "description": "Private PDF toolkit that works in your browser",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6817",
      "container": "8080",
      "description": "BentoPDF web app, published on host as 6817"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "DISABLE_IPV6",
      "key": "DISABLE_IPV6",
      "value": "true",
      "mask": false,
      "description": "true makes the web server listen on IPv4 only, which works on every MOS. Set to false to listen on IPv6 too."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

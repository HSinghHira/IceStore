{
  "name": "Memos",
  "repo": "ghcr.io/usememos/memos:26.11.1",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/usememos/memos/pkgs/container/memos",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=512m --cpus=1.00 --memory-reservation=32m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:5230/healthz\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5230]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/memos/icon.png",
  "project": "https://www.usememos.com/",
  "support": "https://github.com/usememos/memos/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/memos/",
  "description": "Quick notes on a timeline, like a private Twitter just for you",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Memos",
      "host": "/mnt/cache/appdata/memos/data",
      "container": "/var/opt/memos",
      "mode": "rw",
      "description": "The Memos database (memos_prod.db) and your uploaded files. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6791",
      "container": "5230",
      "description": "Memos web app and API, published on host as 6791"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "MEMOS_PORT",
      "key": "MEMOS_PORT",
      "value": "5230",
      "mask": false,
      "description": "The port Memos listens on inside the container. Leave it at 5230."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "OpenSpeedTest",
  "repo": "openspeedtest/latest:v2.0.9",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/openspeedtest/latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=128m --memory-reservation=8m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:3000/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/openspeedtest/icon.png",
  "project": "https://openspeedtest.com",
  "support": "https://github.com/openspeedtest/Speed-Test/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/openspeedtest/",
  "description": "Tests the speed between your devices and your MOS in the browser",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6854",
      "container": "3000",
      "description": "OpenSpeedTest web page, published on host as 6854"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

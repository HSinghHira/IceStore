{
  "name": "Password-Pusher",
  "repo": "ghcr.io/hsinghhira/passwordpusher:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/hsinghhira/passwordpusher/pkgs/container/passwordpusher",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=1024m --cpus=1.00 --memory-reservation=128m --health-cmd=\"curl -fsS http://127.0.0.1:5100/up\" --health-interval=30s --health-timeout=5s --health-start-period=90s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5100]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/passwordpusher/icon.png",
  "project": "https://pwpush.com",
  "support": "https://github.com/pglombardo/PasswordPusher/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/passwordpusher/",
  "description": "Share passwords and secrets through links that expire.",
  "architecture": [
    "amd64"
  ],
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/cache/appdata/passwordpusher/storage",
      "container": "/opt/PasswordPusher/storage",
      "mode": "rw",
      "description": "The database, uploaded files and this install's secret key (.secret_key_base). Back this folder up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6747",
      "container": "5100",
      "description": "Password Pusher web page and API, published on host as 6747"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Nexterm",
  "repo": "ghcr.io/hsinghhira/nexterm:1.0.1",
  "category": [
    "Utilities"
  ],
  "registry": "https://github.com/hsinghhira/nexterm/pkgs/container/nexterm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2048m --cpus=2.00 --memory-reservation=192m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:6989/\" --health-interval=30s --health-timeout=10s --health-start-period=120s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6989]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/nexterm/icon.png",
  "project": "https://nexterm.dev/",
  "support": "https://github.com/gnmyt/Nexterm/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/nexterm/",
  "description": "SSH, VNC and RDP to all your servers from the browser",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/nexterm/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Everything Nexterm keeps: the database with your servers and saved logins (encrypted), session recordings, logs and this install's own key (secrets.env). Back it up, and keep the key with it: without it the saved logins can't be read."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6777",
      "container": "6989",
      "description": "Nexterm web UI, published on host as 6777"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

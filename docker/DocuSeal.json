{
  "name": "DocuSeal",
  "repo": "docuseal/docuseal:3.3.3",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/docuseal/docuseal",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=40 --memory=1024m --cpus=1.00 --memory-reservation=256m",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/docuseal/icon.png",
  "project": "https://www.docuseal.com",
  "support": "https://github.com/docusealco/docuseal/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/docuseal/",
  "description": "Open source DocuSign alternative to create, fill and sign PDF documents",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/docuseal/data",
      "container": "/data",
      "mode": "rw",
      "description": "Everything DocuSeal keeps, in docuseal/: the SQLite database, uploaded and signed documents, and docuseal.env with the secret key made on first start. Back this folder up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6148",
      "container": "3000",
      "description": "DocuSeal web UI, published on host as 6148"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Beszel",
  "repo": "henrygd/beszel:0.21.2",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/henrygd/beszel",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=32m --health-cmd=\"/beszel health --url http://localhost:8090\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8090]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/beszel/icon.png",
  "project": "https://beszel.dev",
  "support": "https://github.com/henrygd/beszel/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/beszel/",
  "description": "Lightweight server monitoring with history, Docker stats and alerts",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Beszel_Data",
      "host": "/mnt/cache/appdata/beszel/data",
      "container": "/beszel_data",
      "mode": "rw",
      "description": "The hub's database with your systems, history, users and alerts, and its SSH key. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6825",
      "container": "8090",
      "description": "Beszel hub web app, published on host as 6825"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

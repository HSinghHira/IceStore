{
  "name": "Adminer",
  "repo": "adminer:6.3.1",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/_/adminer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=16m",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/adminer/icon.png",
  "project": "https://www.adminer.org",
  "support": "https://github.com/vrana/adminer/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/adminer/",
  "description": "Database manager in a single page for MySQL, PostgreSQL, SQLite and more",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6848",
      "container": "8080",
      "description": "Adminer web page, published on host as 6848"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "ADMINER_DESIGN",
      "key": "ADMINER_DESIGN",
      "value": "pepa-linha",
      "mask": false,
      "description": "The look of the page, like pepa-linha, dracula, nette or hydra. Leave empty for the classic one."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

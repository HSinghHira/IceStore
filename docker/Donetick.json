{
  "name": "Donetick",
  "repo": "ghcr.io/hsinghhira/donetick:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/hsinghhira/donetick/pkgs/container/donetick",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=15 --memory=256m --memory-reservation=16m --health-cmd=\"wget -q --spider http://127.0.0.1:2021/\" --health-interval=30s --health-timeout=5s --health-start-period=20s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2021]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/donetick/icon.png",
  "project": "https://donetick.com",
  "support": "https://github.com/donetick/donetick/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/donetick/",
  "description": "Share chores and tasks with your household, with smart repeats",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Donetick Data",
      "host": "/mnt/cache/appdata/donetick/data",
      "container": "/donetick-data",
      "mode": "rw",
      "description": "Donetick's SQLite database with your chores, users and history, plus the sign-in secret. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6899",
      "container": "2021",
      "description": "Donetick web app and API, published on host as 6899"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "DONETICK_DISABLE_SIGNUP",
      "key": "DONETICK_DISABLE_SIGNUP",
      "value": "false",
      "mask": false,
      "description": "true stops new sign-ups. Make accounts for your household first, then set true."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

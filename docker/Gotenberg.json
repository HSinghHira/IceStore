{
  "name": "Gotenberg",
  "repo": "gotenberg/gotenberg:9.10.0",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/gotenberg/gotenberg",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=2g --memory-reservation=128m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:3000/health\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/health",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/gotenberg/icon.png",
  "project": "https://gotenberg.dev",
  "support": "https://github.com/gotenberg/gotenberg/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/gotenberg/",
  "description": "API that turns web pages, Markdown and Office files into PDF",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6820",
      "container": "3000",
      "description": "Gotenberg API, published on host as 6820"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

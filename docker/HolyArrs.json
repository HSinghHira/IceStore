{
  "name": "HolyArrs",
  "repo": "holyarrs/holyarrs:1.2.0",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/holyarrs/holyarrs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=40 --memory=1024m --cpus=2.00 --memory-reservation=128m --health-cmd=\"/holyarrs -healthcheck\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6262]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/holyarrs/icon.png",
  "project": "https://holyarrs.com",
  "support": "https://github.com/HolyArrs/HolyArrs/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/holyarrs/",
  "description": "One app to find, download and organize your shows, movies and music",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/holyarrs/config",
      "container": "/config",
      "mode": "rw",
      "description": "Databases, settings, the master key, backups and logs. Back it up. Keep it on a local disk, never a network share."
    },
    {
      "name": "Movies",
      "host": "/mnt/cache/media/Movies",
      "container": "/movies",
      "mode": "rw",
      "description": "Your movie library, from /mnt/cache/media/Movies."
    },
    {
      "name": "Tv",
      "host": "/mnt/cache/media/TV Shows",
      "container": "/tv",
      "mode": "rw",
      "description": "Your shows library, from /mnt/cache/media/TV Shows."
    },
    {
      "name": "Music",
      "host": "/mnt/cache/media/Music",
      "container": "/music",
      "mode": "rw",
      "description": "Your music library, from /mnt/cache/media/Music."
    },
    {
      "name": "Downloads",
      "host": "/mnt/cache/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Your downloader's download folder, from /mnt/cache/downloads. Point your downloader at the same folder."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6754",
      "container": "6262",
      "description": "HolyArrs web app, published on host as 6754"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "mask": false,
      "description": "The user id that owns the app's files. 500 is the MOS default."
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "mask": false,
      "description": "The group id that owns the app's files. 500 is the MOS default."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "KitchenOwl",
  "repo": "ghcr.io/hsinghhira/kitchenowl:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/hsinghhira/kitchenowl/pkgs/container/kitchenowl",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=512m --memory-reservation=64m --health-cmd=\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080'\" --health-interval=30s --health-timeout=10s --health-start-period=60s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/kitchenowl/icon.png",
  "project": "https://kitchenowl.org",
  "support": "https://github.com/TomBursch/kitchenowl/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/kitchenowl/",
  "description": "Shared grocery list, recipes, meal plans and expenses for your household",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/kitchenowl/data",
      "container": "/data",
      "mode": "rw",
      "description": "The database, uploaded photos and this install's JWT secret (.icestore-jwt-secret-key). Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6862",
      "container": "8080",
      "description": "KitchenOwl web app and API for the phone apps, published on host as 6862"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Ghostfolio",
  "repo": "ghcr.io/hsinghhira/ghostfolio:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/hsinghhira/ghostfolio/pkgs/container/ghostfolio",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=60 --memory=1536m --cpus=2.00 --memory-reservation=256m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:3333/api/v1/health\" --health-interval=30s --health-timeout=10s --health-start-period=300s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3333]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/ghostfolio/icon.png",
  "project": "https://ghostfol.io/",
  "support": "https://github.com/ghostfolio/ghostfolio/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/ghostfolio/",
  "description": "Wealth tracker for stocks, ETFs and crypto across your accounts",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/ghostfolio/data",
      "container": "/data",
      "mode": "rw",
      "description": "Everything Ghostfolio keeps: the PostgreSQL database (postgres), the Redis cache (redis) and this install's own keys (secrets.env). Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6772",
      "container": "3333",
      "description": "Ghostfolio web UI and API, published on host as 6772"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

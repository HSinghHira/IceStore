{
  "name": "Dashy",
  "repo": "ghcr.io/hsinghhira/dashy:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/hsinghhira/dashy/pkgs/container/dashy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=512m --cpus=1.00 --memory-reservation=64m --health-cmd=\"node services/healthcheck.js\" --health-interval=60s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/dashy/icon.png",
  "project": "https://dashy.to",
  "support": "https://github.com/Lissy93/dashy/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/dashy/",
  "description": "A dashboard for your homelab, with status checks, widgets and themes.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "User Data",
      "host": "/mnt/cache/appdata/dashy/user-data",
      "container": "/app/user-data",
      "mode": "rw",
      "description": "Your dashboard: conf.yml (sections, items, theme, users) and its backups. A sample conf.yml is put here on first start. Back this folder up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6732",
      "container": "8080",
      "description": "Dashy web page, published on host as 6732"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

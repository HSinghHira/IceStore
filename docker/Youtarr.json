{
  "name": "Youtarr",
  "repo": "ghcr.io/hsinghhira/youtarr:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/hsinghhira/youtarr/pkgs/container/youtarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=60 --memory=2048m --cpus=2.00 --memory-reservation=256m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:8080/api/health\" --health-interval=30s --health-timeout=10s --health-start-period=180s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/youtarr/icon.png",
  "project": "https://youtarr.com",
  "support": "https://github.com/DialmasterOrg/Youtarr/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/youtarr/",
  "description": "Downloads and organizes YouTube channels on a schedule for your media server",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/youtarr/data",
      "container": "/data",
      "mode": "rw",
      "description": "The MariaDB database (channels, videos, jobs), Youtarr's config, job files and thumbnails, and state/secrets.env. Back it up."
    },
    {
      "name": "Videos",
      "host": "/mnt/cache/media/YouTube",
      "container": "/videos",
      "mode": "rw",
      "description": "Where downloaded videos go, one folder per channel. Add /mnt/cache/media/YouTube to Plex, Jellyfin, Emby or Kodi."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6755",
      "container": "8080",
      "description": "Youtarr web UI and API, published on host as 6755"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

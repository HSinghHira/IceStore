{
  "name": "Heimdall",
  "repo": "lscr.io/linuxserver/heimdall:v2.8.4-ls375",
  "category": [
    "Productivity"
  ],
  "registry": "https://lscr.io/linuxserver/heimdall",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=32m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:80/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/heimdall/icon.png",
  "project": "https://heimdall.site",
  "support": "https://github.com/linuxserver/docker-heimdall/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/heimdall/",
  "description": "Simple start page for all your web apps and links",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/heimdall/config",
      "container": "/config",
      "mode": "rw",
      "description": "Heimdall's database, your tiles, icons and settings. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6870",
      "container": "80",
      "description": "Heimdall start page, published on host as 6870"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "mask": false,
      "description": "The user id that owns the app's files. 500 is the MOS default."
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "mask": false,
      "description": "The group id that owns the app's files. 500 is the MOS default."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Spliit",
  "repo": "ghcr.io/hsinghhira/spliit:1.0.1",
  "category": [
    "Productivity"
  ],
  "registry": "https://github.com/hsinghhira/spliit/pkgs/container/spliit",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=60 --memory=1024m --cpus=1.00 --memory-reservation=128m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:3000/\" --health-interval=30s --health-timeout=10s --health-start-period=180s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/spliit/icon.png",
  "project": "https://spliit.app/",
  "support": "https://github.com/spliit-app/spliit/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/spliit/",
  "description": "Share expenses with friends and family, a Splitwise alternative",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/spliit/data",
      "container": "/data",
      "mode": "rw",
      "description": "The PostgreSQL database with your groups and expenses (postgres) and this install's own keys (secrets.env). Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6787",
      "container": "3000",
      "description": "Spliit web app, published on host as 6787"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "DEFAULT_CURRENCY_CODE",
      "key": "DEFAULT_CURRENCY_CODE",
      "value": "USD",
      "mask": false,
      "description": "The currency picked for new groups, like USD, EUR, GBP, INR or NZD. Each group can use its own."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Homarr",
  "repo": "ghcr.io/hsinghhira/homarr:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://github.com/hsinghhira/homarr/pkgs/container/homarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=1024m --cpus=1.00 --memory-reservation=192m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:7575/api/health/live\" --health-interval=30s --health-timeout=10s --health-start-period=120s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7575]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/homarr/icon.png",
  "project": "https://homarr.dev/",
  "support": "https://github.com/homarr-labs/homarr/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/homarr/",
  "description": "Dashboard for your home server with widgets for all your apps",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/homarr/appdata",
      "container": "/appdata",
      "mode": "rw",
      "description": "Everything Homarr keeps: the SQLite database with your boards and integrations (db), its cache (redis), trusted certificates and this install's own key (secrets.env). Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6774",
      "container": "7575",
      "description": "Homarr dashboard, published on host as 6774"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

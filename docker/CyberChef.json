{
  "name": "CyberChef",
  "repo": "ghcr.io/gchq/cyberchef:11.5.0",
  "category": [
    "Utilities"
  ],
  "registry": "https://github.com/gchq/cyberchef/pkgs/container/cyberchef",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=20 --memory=128m --cpus=0.50 --memory-reservation=16m --health-cmd=\"wget -q --spider http://127.0.0.1:8080/\" --health-interval=30s --health-timeout=5s --health-start-period=15s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/cyberchef/icon.png",
  "project": "https://gchq.github.io/CyberChef/",
  "support": "https://github.com/gchq/CyberChef/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/cyberchef/",
  "description": "The Cyber Swiss Army Knife for encoding, decoding and analysing data.",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6729",
      "container": "8080",
      "description": "CyberChef web page, published on host as 6729"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

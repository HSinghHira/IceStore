{
  "name": "OmniTools",
  "repo": "iib0011/omni-tools:0.7.0",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/iib0011/omni-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=10 --memory=128m --memory-reservation=16m --health-cmd=\"wget -q --spider http://127.0.0.1/\" --health-interval=30s --health-timeout=5s --health-start-period=15s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/omni-tools/icon.png",
  "project": "https://omnitools.app",
  "support": "https://github.com/iib0011/omni-tools/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/omni-tools/",
  "description": "Everyday tools for images, PDFs, video, text and numbers, in your browser",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6895",
      "container": "80",
      "description": "OmniTools web page, published on host as 6895"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

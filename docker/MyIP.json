{
  "name": "MyIP",
  "repo": "jason5ng32/myip:v8.2.0",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/jason5ng32/myip",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=32m --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:18966/\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:18966]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/myip/icon.png",
  "project": "https://ipcheck.ing",
  "support": "https://github.com/jason5ng32/MyIP/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/myip/",
  "description": "All-in-one IP toolbox for checking your connection, DNS, WebRTC and speed",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6826",
      "container": "18966",
      "description": "MyIP web page, published on host as 6826"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

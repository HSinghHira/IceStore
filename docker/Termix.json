{
  "name": "Termix",
  "repo": "ghcr.io/lukegus/termix:release-2.9.2",
  "category": [
    "Utilities"
  ],
  "registry": "https://github.com/lukegus/termix/pkgs/container/termix",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=1g --memory-reservation=64m",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/termix/icon.png",
  "project": "https://termix.site",
  "support": "https://github.com/Termix-SSH/Termix/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/termix/",
  "description": "SSH terminals, file manager and tunnels for your servers in the browser",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/termix/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Termix's database with users, saved hosts, keys and passwords (encrypted). Keep it private and back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6872",
      "container": "8080",
      "description": "Termix web app, published on host as 6872"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

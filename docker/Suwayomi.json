{
  "name": "Suwayomi",
  "repo": "ghcr.io/suwayomi/suwayomi-server:v2.4.2490",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/suwayomi/suwayomi-server/pkgs/container/suwayomi-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout=30 --memory=2048m --cpus=2.00 --memory-reservation=256m --user=0:0 --health-cmd=\"curl -fsS -o /dev/null http://127.0.0.1:4567/\" --health-interval=30s --health-timeout=10s --health-start-period=180s --health-retries=5",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4567]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/suwayomi/icon.png",
  "project": "https://suwayomi.org/",
  "support": "https://github.com/Suwayomi/Suwayomi-Server/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/suwayomi/",
  "description": "Manga reader server with extensions, downloads and a web reader",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Downloads",
      "host": "/mnt/cache/media/Manga",
      "container": "/home/suwayomi/.local/share/Tachidesk/downloads",
      "mode": "rw",
      "description": "Downloaded chapters, in /mnt/cache/media/Manga."
    },
    {
      "name": "Tachidesk",
      "host": "/mnt/cache/appdata/suwayomi/data",
      "container": "/home/suwayomi/.local/share/Tachidesk",
      "mode": "rw",
      "description": "Suwayomi's library database, extensions, settings, backups and logs. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6785",
      "container": "4567",
      "description": "Suwayomi web reader and API, published on host as 6785"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "AUTH_MODE",
      "key": "AUTH_MODE",
      "value": "none",
      "mask": false,
      "description": "none lets anyone on your network in. For a login, set it to ui_login and add AUTH_USERNAME and AUTH_PASSWORD (see the Variables tab)."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}

{
  "name": "Wakapi",
  "repo": "ghcr.io/hsinghhira/wakapi:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://github.com/hsinghhira/wakapi/pkgs/container/wakapi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --memory=256m --memory-reservation=16m --health-cmd=\"wget -q -O /dev/null http://127.0.0.1:3000/api/health\" --health-interval=30s --health-timeout=10s --health-start-period=30s --health-retries=3",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://cdn.jsdelivr.net/gh/HSinghHira/IceStore@main/Apps/wakapi/icon.png",
  "project": "https://wakapi.dev",
  "support": "https://github.com/muety/wakapi/issues",
  "readme_url": "https://icestore.hsinghhira.me/app/wakapi/",
  "description": "Coding time tracker that works with the WakaTime editor plugins",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/wakapi/data",
      "container": "/data",
      "mode": "rw",
      "description": "The SQLite database with your users, heartbeats and stats, and this install's password salt. Back it up."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "6865",
      "container": "3000",
      "description": "Wakapi web app and WakaTime-compatible API, published on host as 6865"
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Etc/UTC",
      "mask": false,
      "description": "Your time zone, like Europe/London or America/New_York."
    },
    {
      "name": "WAKAPI_INSECURE_COOKIES",
      "key": "WAKAPI_INSECURE_COOKIES",
      "value": "true",
      "mask": false,
      "description": "true lets you sign in over plain http. Set to false once Wakapi is behind https."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
